# ==============================================================================
# Karpagam Earthmovers - Environment Configuration
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB)
# MongoDB local or Atlas URI. Leave empty for the non-production JSON fallback.
MONGODB_URI=
DEV_STORE_PATH=./data/dev-store.json

# Security & Authentication
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Initial admin is seeded only when all values below and JWT_SECRET are set.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=

# Company Public Info & WhatsApp Configuration
COMPANY_NAME=Karpagam Earthmovers
COMPANY_PHONE=+91 93847 82583
WHATSAPP_NUMBER=919384782583
COMPANY_EMAIL=karpagamearthmovers@gmail.com
COMPANY_LOCATION=Pollachi, Tamil Nadu, India

# CORS Origins (comma separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:8443,http://localhost:3000

# Optional SMTP Email Notifications
# Leave blank to log emails to console in development
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Karpagam Earthmovers" <noreply@karpagamearthmovers.com>
NOTIFICATION_EMAIL=karpagamearthmovers@gmail.com
